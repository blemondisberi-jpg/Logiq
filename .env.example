# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Database
MONGODB_URI=mongodb://localhost:27017

# Environment
ENVIRONMENT=development

# Platform verification / Twitch
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# Platform verification / YouTube
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_OAUTH_CLIENT_ID=your_youtube_oauth_client_id_here
YOUTUBE_OAUTH_CLIENT_SECRET=your_youtube_oauth_client_secret_here

# Platform verification / Kick
KICK_CLIENT_ID=your_kick_client_id_here
KICK_CLIENT_SECRET=your_kick_client_secret_here
